# Copy this file to .env and fill in your real API keys.
# Never commit .env to version control.

# US Census Bureau API — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# NewsAPI — https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HUD Fair Market Rents (no key required for public endpoints; set if using auth)
HUD_API_TOKEN=your_hud_api_token_here

# Gmail SMTP — for demo email sending (--send-emails flag)
# Use a Gmail App Password, NOT your login password:
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_no_spaces
DEMO_RECIPIENT_EMAIL=your.email@gmail.com
